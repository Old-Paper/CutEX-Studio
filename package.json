{
  "name": "cutex-studio",
  "version": "0.8.0",
  "packageManager": "pnpm@9.15.9",
  "description": "Local-first automatic rough cut tool for voice-over media",
  "main": "dist/main/index.js",
  "author": "CutEX Studio",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:electron && electron-vite dev",
    "prepare:electron": "node node_modules/electron/install.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint .",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run prepare:electron && npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "4.1.12",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "electron-vite": "^3.1.0",
    "playwright-core": "1.64.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  },
  "build": {
    "appId": "studio.cutex.app",
    "productName": "CutEX Studio",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "CutEX-Studio-${version}-Windows.${ext}"
    }
  }
}
